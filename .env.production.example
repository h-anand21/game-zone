# ============================================================
# GameHub — Production Environment Variables Template
# Copy this to .env and fill in real values
# ============================================================

# ── Backend (Port 5000) ──────────────────────────────────────
NODE_ENV=production
PORT=5000

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/gamehub?sslmode=require

# Auth
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRES_IN=7d

# Security
CORS_ORIGIN=https://yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── FPS Server (Port 5001) ────────────────────────────────────
FPS_PORT=5001
EXPRESS_BACKEND_URL=http://localhost:5000
TICK_RATE=60
MAX_PLAYERS_PER_ROOM=8
MATCHMAKING_TIMEOUT_MS=30000

# ── Mobile App (Expo) ────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://api.yourdomain.com
EXPO_PUBLIC_WS_URL=wss://ws.yourdomain.com
EXPO_PUBLIC_FPS_WS_URL=wss://fps.yourdomain.com
